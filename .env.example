APP_NAME=PVP.gg
APP_ENV=local
AUTH_MODE=dev
DEV_ADMIN_EMAIL=dev-admin@example.local
DATABASE_URL=postgresql+psycopg://pvp:pvp@localhost:5432/pvpgg
SESSION_SECRET=replace-this-before-production
SESSION_HTTPS_ONLY=false

# AUTH_MODE=google 전환 시 사용합니다. localhost 콜백은 HTTP로 테스트할 수 있습니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google
GOOGLE_SUPER_ADMIN_EMAILS=owner@example.com
# 사설 인증서가 끼는 로컬 네트워크에서만 false로 둡니다. 운영은 true를 유지하세요.
GOOGLE_OAUTH_VERIFY_SSL=true
PUBLIC_CACHE_TTL_SECONDS=300
